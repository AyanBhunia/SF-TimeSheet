<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>dbt__Employee__c</field>
        <field>dbt__Start_Date__c</field>
        <field>dbt__End_Date__c</field>
        <field>dbt__Day_Count__c</field>
        <field>dbt__Total_Hours__c</field>
        <field>dbt__Notes__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>dbt__Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Manager</label>
        <name>Manager</name>
    </approvalStep>
    <description>One PTO request (all its days), approved by the employee&apos;s manager (Approver__c). Emails the approver on submit (PTO: Approval Request) and the employee on submit, approval and rejection. The PTO tab approves and rejects these too.</description>
    <emailTemplate>PTO_Emails/PTO_Approval_Request</emailTemplate>
    <entryCriteria>
        <criteriaItems>
            <field>dbt__PTO_Request__c.dbt__Status__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>PTO_Request_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>PTO_Set_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>PTO_Request_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>PTO_Set_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>PTO_Request_Submitted</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Leave Approval</label>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
