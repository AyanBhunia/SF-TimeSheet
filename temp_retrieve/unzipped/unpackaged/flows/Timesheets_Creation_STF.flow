<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Timesheet_Masters_to_Collection</name>
        <label>Add Timesheet Masters to Collection</label>
        <locationX>396</locationX>
        <locationY>900</locationY>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecordCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>TimesheetMasterRecord</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Employee_Loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_values_to_Timesheet_Master</name>
        <label>Assign values to Timesheet Master</label>
        <locationX>396</locationX>
        <locationY>792</locationY>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.End_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>endDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.Start_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>effectiveStartDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>effectiveRecordName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Employee_Loop.User__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.Manager__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Employee_Loop.Manager__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.Employee__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Employee_Loop.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>TimesheetMasterRecord.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Timesheet_Masters_to_Collection</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Existing_Timesheets_For_Employee</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Existing Timesheets For Employee</label>
        <locationX>308</locationX>
        <locationY>576</locationY>
        <assignNextValueToReference>currentItem_Filter_Existing_Timesheets_For_Employee</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Existing_Timesheets</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Existing_Timesheets_For_Employee.Employee__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Employee_Loop.Id</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Check_If_Timesheet_Exists</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Check_If_Any_Timesheets_To_Create</name>
        <label>Check If Any Timesheets To Create</label>
        <locationX>176</locationX>
        <locationY>1092</locationY>
        <defaultConnectorLabel>None To Create</defaultConnectorLabel>
        <rules>
            <name>Has_Records_To_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TimesheetMasterRecordCollection</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Timesheet_Masters</targetReference>
            </connector>
            <label>Has Records To Create</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_If_Timesheet_Exists</name>
        <label>Check If Timesheet Exists</label>
        <locationX>308</locationX>
        <locationY>684</locationY>
        <defaultConnector>
            <targetReference>Assign_values_to_Timesheet_Master</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Timesheet Does Not Exist</defaultConnectorLabel>
        <rules>
            <name>Timesheet_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_Existing_Timesheets_For_Employee</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Employee_Loop</targetReference>
            </connector>
            <label>Timesheet Already Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Employee_User_Active</name>
        <label>Is Employee User Active?</label>
        <locationX>462</locationX>
        <locationY>468</locationY>
        <defaultConnector>
            <targetReference>Employee_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Active_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Employee_Loop.User__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Employee_Loop.User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Existing_Timesheets_For_Employee</targetReference>
            </connector>
            <label>Active User</label>
        </rules>
    </decisions>
    <description>Creates timesheets for each active employee with flexible start and end dates based on Timesheet Default Value metadata (Weekly, Bi-Weekly, Monthly, Custom) and prevents duplicates.</description>
    <environments>Default</environments>
    <formulas>
        <name>cycleType</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!Get_Default_Values.Timesheet_Cycle_Type__c})), &quot;Weekly&quot;, TEXT({!Get_Default_Values.Timesheet_Cycle_Type__c}))</expression>
    </formulas>
    <formulas>
        <name>effectiveRecordName</name>
        <dataType>String</dataType>
        <expression>&quot;Timesheet for &quot; + TEXT({!effectiveStartDate}) + &quot; to &quot; + TEXT({!endDate})</expression>
    </formulas>
    <formulas>
        <name>effectiveStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(NOT(ISBLANK({!Employee_Loop.Hire_Date__c})) &amp;&amp; {!Employee_Loop.Hire_Date__c} &gt; {!startDate} &amp;&amp; {!Employee_Loop.Hire_Date__c} &lt;= {!endDate}, {!Employee_Loop.Hire_Date__c}, {!startDate})</expression>
    </formulas>
    <formulas>
        <name>endDate</name>
        <dataType>Date</dataType>
        <expression>IF({!cycleType} = &quot;Monthly&quot;, IF(MONTH({!startDate}) = 12, DATE(YEAR({!startDate}), 12, 31), DATE(YEAR({!startDate}), MONTH({!startDate}) + 1, 1) - 1), IF({!cycleType} = &quot;Bi-Weekly&quot;, {!startDate} + 13, IF({!cycleType} = &quot;Custom&quot; &amp;&amp; NOT(ISBLANK({!Get_Default_Values.Timesheet_Duration_Days__c})), {!startDate} + {!Get_Default_Values.Timesheet_Duration_Days__c} - 1, {!startDate} + 6)))</expression>
    </formulas>
    <formulas>
        <name>Record_Name</name>
        <dataType>String</dataType>
        <expression>&quot;Timesheet for &quot; + TEXT({!startDate}) + &quot; to &quot; + TEXT({!endDate})</expression>
    </formulas>
    <formulas>
        <name>startDate</name>
        <dataType>Date</dataType>
        <expression>IF({!cycleType} = &quot;Monthly&quot;, DATE(YEAR(TODAY()), MONTH(TODAY()), 1), IF({!weekStartDay} = &quot;Sunday&quot;, TODAY() - (WEEKDAY(TODAY()) - 1), TODAY() - IF(WEEKDAY(TODAY()) = 1, 6, WEEKDAY(TODAY()) - 2)))</expression>
    </formulas>
    <formulas>
        <name>weekStartDay</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!Get_Default_Values.Week_Start_Day__c})), &quot;Monday&quot;, TEXT({!Get_Default_Values.Week_Start_Day__c}))</expression>
    </formulas>
    <interviewLabel>Timesheets Creation STF {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Timesheets Creation STF</label>
    <loops>
        <name>Employee_Loop</name>
        <label>Employee Loop</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <collectionReference>Get_Employees</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Employee_User_Active</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_If_Any_Timesheets_To_Create</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Timesheet_Masters</name>
        <label>Create Timesheet Masters</label>
        <locationX>50</locationX>
        <locationY>1200</locationY>
        <inputReference>TimesheetMasterRecordCollection</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Default_Values</name>
        <label>Get Timesheet Default Values</label>
        <locationX>176</locationX>
        <locationY>144</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Employees</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Values</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Timesheet_Default_Value__mdt</object>
        <queriedFields>Timesheet_Cycle_Type__c</queriedFields>
        <queriedFields>Week_Start_Day__c</queriedFields>
        <queriedFields>Timesheet_Duration_Days__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Employees</name>
        <label>Get Employees</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Existing_Timesheets</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Is_Demo__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Employee__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>User__c</queriedFields>
        <queriedFields>Manager__c</queriedFields>
        <queriedFields>Hire_Date__c</queriedFields>
        <sortField>Id</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Timesheets</name>
        <label>Get Existing Timesheets for Cycle</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Employee_Loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Start_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>endDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>End_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>startDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Demo__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Timesheet__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Employee__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Default_Values</targetReference>
        </connector>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2024-11-25</startDate>
            <startTime>00:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Filter_Existing_Timesheets_For_Employee</name>
