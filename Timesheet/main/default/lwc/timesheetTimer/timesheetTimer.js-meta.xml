<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Timesheet Timer</masterLabel>
    <description>A beautiful glassmorphic timer for tracking timesheet hours.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__UtilityBar</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage">
            <property name="phoneOnly" type="Boolean" default="false" label="Show on phones only" description="Hide the timer on desktop, for pages where desktop users already have the utility bar timer."/>
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__UtilityBar">
            <property name="label" type="String" default="Time Tracker"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
