    <!-- Decisions -->
    <decisions>
        <name>Decision_Has_Eligible_Items</name>
        <label>Has Eligible Items?</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Screen_No_Items_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Eligible Items</defaultConnectorLabel>
        <rules>
            <name>Outcome_Has_Eligible_Items</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTotalLineItemCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue><numberValue>0.0</numberValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Review_Timesheets</targetReference>
            </connector>
            <label>Eligible Items Found</label>
        </rules>
    </decisions>

    <description>Orchestrates the conversion of approved/submitted timesheets into QuickBooks-aligned customer Intermediate Invoices.</description>
    <environments>Default</environments>
    <interviewLabel>Generate Project Invoices {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Generate Project Invoices</label>
    <processType>Flow</processType>

