<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Fetches the week&apos;s users&apos; assignments of the permission set using ALL ROWS so that expired assignments (hidden from Get Records but still blocking a new insert) are returned as well. Output goes to a named variable: the automatic output of an Apex action cannot be filtered and looped in a packaged flow.</description>
        <name>Get_PS_Assignments</name>
        <label>Get PS Assignments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>GetPermissionSetAssignments</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Loop_User_Ids</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>permissionSetId</name>
            <value>
                <elementReference>Get_Permission_set.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>userIds</name>
            <value>
                <elementReference>User_Ids</elementReference>
            </value>
        </inputParameters>
        <nameSegment>GetPermissionSetAssignments</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>Existing_Assignments</assignToReference>
            <name>assignments</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>Inserts and updates the assignments with partial success: a user who cannot receive the permission set fails alone. Failures are returned in Error_Message.</description>
        <name>Save_Assignments</name>
        <label>Save Assignments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>SavePermissionSetAssignments</actionName>
        <actionType>apex</actionType>
        <faultConnector>
            <targetReference>Capture_Fault</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>toInsert</name>
            <value>
                <elementReference>PSAs_ToInsert</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>toUpdate</name>
            <value>
                <elementReference>PSAs_ToUpdate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SavePermissionSetAssignments</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>Error_Message</assignToReference>
            <name>errors</name>
        </outputParameters>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Collects the user so each user is processed only once.</description>
        <name>Add_User_Id</name>
        <label>Add User Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>User_Ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Pending_Timesheet_Records.Employee__r.User__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Pending_Timesheet_Records</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Fault path: keeps the error for the debug log and ends the flow without an unhandled fault (no error email).</description>
        <name>Capture_Fault</name>
        <label>Capture Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Error_Message</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Creates a new assignment for a user who has none.</description>
        <name>Set_Assignment_To_Insert</name>
        <label>Set Assignment To Insert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PSA_ToInsert.AssigneeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_User_Ids</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PSA_ToInsert.PermissionSetId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Permission_set.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PSA_ToInsert.ExpirationDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Expiry_date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PSAs_ToInsert</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>PSA_ToInsert</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_User_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Extends the existing (or expired) assignment of the user.</description>
        <name>Set_Assignment_To_Update</name>
        <label>Set Assignment To Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PSA_ToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Existing_Assignment.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PSA_ToUpdate.ExpirationDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Expiry_date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>PSAs_ToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>PSA_ToUpdate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Existing_Assignment</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_User_Assignment</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter User Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_User_Assignment</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Existing_Assignments</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_User_Assignment.AssigneeId</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_User_Ids</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Assignment_Found</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Assignment_Found</name>
        <label>Assignment Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Assignment_To_Insert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_User_Assignment</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_User_Assignment</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Existing_Assignment</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Assignments_To_Save</name>
        <label>Has Assignments To Save?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Save_Present</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>PSAs_ToInsert</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PSAs_ToUpdate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Save_Assignments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Skips timesheets whose employee has no user, and users already collected.</description>
        <name>Is_New_User</name>
        <label>Is New User?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Add_User_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>New User</defaultConnectorLabel>
        <rules>
            <name>Skip</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Pending_Timesheet_Records.Employee__r.User__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>User_Ids</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Pending_Timesheet_Records.Employee__r.User__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Pending_Timesheet_Records</targetReference>
            </connector>
            <label>Skip</label>
        </rules>
    </decisions>
    <decisions>
        <name>Permission_Set_Found</name>
        <label>Permission Set Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Permission_Set_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Permission_set.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_PS_Assignments</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Timesheet_record_present</name>
        <label>Timesheet record present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Timesheet_record_present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_This_Week_Timesheets</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_This_Week_Timesheets</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Pending_Timesheet_Records</targetReference>
            </connector>
            <label>Record present</label>
        </rules>
    </decisions>
    <decisions>
        <name>Users_Found</name>
        <label>Users Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Users</defaultConnectorLabel>
        <rules>
            <name>Users_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>User_Ids</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>User_Ids</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Permission_set</targetReference>
            </connector>
            <label>Users Present</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>EndOfWeek</name>
        <dataType>Date</dataType>
        <expression>{!StartOfWeek}+6</expression>
    </formulas>
    <formulas>
        <name>Expiry_date</name>
        <dataType>DateTime</dataType>
        <expression>NOW()+3</expression>
    </formulas>
    <formulas>
        <name>StartOfWeek</name>
        <dataType>Date</dataType>
        <expression>TODAY() - MOD(TODAY() - DATE(1900,1,1), 7)</expression>
    </formulas>
    <interviewLabel>In-app Guidence using STF {!$Flow.CurrentDateTime}</interviewLabel>
    <label>In-app Guidence using STF</label>
    <loops>
        <description>Loops the matched assignment (at most one per user and permission set) so its Id can be read.</description>
        <name>Loop_Existing_Assignment</name>
        <label>Loop Existing Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_User_Assignment</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Assignment_To_Update</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_User_Ids</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Pending_Timesheet_Records</name>
        <label>Loop Pending Timesheet Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_This_Week_Timesheets</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_New_User</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Users_Found</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_User_Ids</name>
        <label>Loop User Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>User_Ids</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Filter_User_Assignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Assignments_To_Save</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
