    <decisions>
        <name>Has_Assignments_To_Update</name>
        <label>Has Assignments To Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Assignments_To_Insert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Update_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>PSAs_ToUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PSAs_ToUpdate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Permission_Set_Assignments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
